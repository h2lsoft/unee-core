# instance dynamic configuration
# SetEnv APP_ENV dev

# instances ############################################################

# my_instance
# SetEnvIf Host ^my_instance\.unee\.app$ APP_DIR=my_instance

# end of instances ############################################################


RewriteEngine On

# Let's Encrypt - exception
RewriteCond %{REQUEST_URI} ^/\.well-known/acme-challenge/ [NC]
RewriteRule ^ - [L]

# cache cdn
<IfModule mod_headers.c>
   SetEnvIf Request_URI "^/cdn/" cache_image=1
    Header set Cache-Control "max-age=31536000, public" env=cache_image
</IfModule>

# force SSL
RewriteCond %{HTTPS} off
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R,L]

# Force HTTPS for 1 year, all subdomains, and preload
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# Content Security Policy (to be adapted)
# Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; object-src 'none'; style-src 'self'"

# Prevent clickjacking
Header always set X-Frame-Options "SAMEORIGIN"

# Prevent MIME sniffing
Header always set X-Content-Type-Options "nosniff"

# Referrer Policy
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions Policy (to be adapted)
Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), fullscreen=(self), payment=(self)"

# no listing
Options -Indexes

# url normalization redirects are skipped on /api/: a 301/302 turns POST/PUT/DELETE into GET
# THE_REQUEST (original request line) is tested, REQUEST_URI is already /index.php on the second rewrite pass

# Remove multiple slashes anywhere in the URL-path
RewriteCond %{THE_REQUEST} !^\S+\s/api/
RewriteCond %{THE_REQUEST} \s[^?]*//
RewriteRule (.*) /$1 [R=302,L]

# force trailing slash at end
RewriteCond %{THE_REQUEST} !^\S+\s/api/
RewriteCond %{REQUEST_URI} !(/$|\.)
RewriteRule (.*) %{REQUEST_URI}/ [R=301,L]

# force robots
RewriteRule ^robots\.txt$ robots.txt.php [L]


# core force index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# forbidden *.inc.php, *.tpl.php, *.class.php, *.twig
<FilesMatch "\.(?:inc.php|tpl.php|class.php|twig|phar|old|bak)$">
  Require all denied
</FilesMatch>

# protect vendor/composer
RewriteRule ^composer\.(lock|json)$ / [F,L]
RewriteCond %{REQUEST_URI} !^/vendor/php-debugbar/php-debugbar/src/DebugBar/Resources
RewriteRule ^vendor/(.*)?$ / [F,L]

